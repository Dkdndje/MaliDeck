#!/bin/bash
# The Linux runtime's session. DroidDeck execs this under proot with the output size and mode;
# the first pass starts gamescope, which execs this script again inside it for the program:
#   droiddeck-session desktop            the file manager
#   droiddeck-session run <path>         a Linux program (AppImage, script or ELF)
#   droiddeck-session steam [steam-url]  the native Steam client
#   droiddeck-session lxqt               the KDE Plasma desktop (DroidDeck's desktop package)
# BL_WIDTH / BL_HEIGHT size the output, BL_FPS limits it, BL_LOG collects everything said here.
set -u
export HOME=${HOME:-/root}
mode=${1:-desktop}
shift || true
# One line per milestone, greppable as "== STEP", so a first run reads as a narrative rather than
# something to be reconstructed from Steam's own chatter. The app shows these while it waits.
step() { echo "== STEP $(date -u +%H:%M:%S) $*"; }
if [ -n "${BL_LOG:-}" ] && [ -z "${BL_INSIDE:-}" ]; then
  mkdir -p "$(dirname "$BL_LOG")" 2>/dev/null
  # The client alone writes megabytes an hour; one earlier log is kept, not every session's.
  if [ "$(stat -c %s "$BL_LOG" 2>/dev/null || echo 0)" -gt 8388608 ]; then
    mv -f "$BL_LOG" "$BL_LOG.1"
  fi
  # A guest looping on an error writes gigabytes in minutes (an Xwayland proot had lost track of
  # managed 9 GB of one line in 19 min): the log keeps its first BL_LOG_CAP bytes and the rest is
  # drained, not refused - a writer that filled it must not die of SIGPIPE.
  exec > >({ dd of="$BL_LOG" oflag=append conv=notrunc iflag=count_bytes count="${BL_LOG_CAP:-268435456}" bs=65536 status=none; cat >/dev/null; }) 2>&1
  echo "== droiddeck-session $(date) mode=$mode $*"
  echo "== uid=$(id -u) size=${BL_WIDTH:-?}x${BL_HEIGHT:-?} fps=${BL_FPS:-0} icd=${VK_ICD_FILENAMES:-none}"
  echo "== gamescope: $(gamescope --version 2>&1 | head -1) at $(command -v gamescope)"
  echo "== rootfs: $(cat /.version 2>/dev/null || echo unversioned)"
  # Build 40's own log: the GPU stack spent one file descriptor per submission and never
  # gave it back - 56 a second, from the first half minute, until nine minutes in every
  # allocation in the session failed with 'Too many open files': no GPU memory, no X
  # connections, no game. Memory was never what ran out - 1.8 GB was still free when it
  # went. So a session lasts as long as its ceiling allows, and the ceiling is the one
  # thing here that can be raised: take every descriptor the OS will hand over and say in
  # the log how many that was. Raising the soft limit to the hard one needs no privilege.
  _bl_fd_hard=$(ulimit -Hn 2>/dev/null) || _bl_fd_hard=
  if [ -n "$_bl_fd_hard" ]; then
    ulimit -n "$_bl_fd_hard" 2>/dev/null || :
    echo "== fd limit: soft $(ulimit -Sn 2>/dev/null || echo '?') hard $_bl_fd_hard"
  fi
fi

# What killed sessions leave in /tmp: MangoHud configs, Steam's crash pipes and shared-memory
# files, Chromium's scoped_dir* with SingletonSocket inside, AppImage stamps, session buses, and
# empty KWin decoration folders. Each pattern is skipped while the program that owns it is up in
# another session (desktop + Steam); one find call takes the rest.
clear_stale_tmp() {
  local running names=() n
  running=$(pgrep -af 'steamwebhelper|steamrtarm64/steam|--type=|droiddeck-appimage-run|dbus-run-session|dbus-daemon.*--session|dbus-launch|kwin|plasmashell' 2>/dev/null)
  case $running in
    *steamwebhelper* | *steamrtarm64/steam*) ;;
    *) names+=(-o -name 'mangohud.????????' -o -name '.com.valvesoftware.Steam.??????'
               -o -name 'steam_chrome_shmem_uid*' -o \( -type d -empty -name 'steam??????' \)) ;;
  esac
  case $running in *--type=*) ;; *) names+=(-o \( -type d -name 'scoped_dir??????' \)) ;; esac
  case $running in *droiddeck-appimage-run*) ;; *) names+=(-o -name 'droiddeck-appimage.??????') ;; esac
  case $running in
    *dbus-run-session* | *dbus-daemon*--session* | *dbus-launch*) ;;
    *) names+=(-o \( -type s -name 'dbus-??????????' \)) ;;
  esac
  case $running in
    *kwin* | *plasmashell*) ;;
    *) names+=(-o \( -type d -empty -name 'plasma-csd-generator.??????' \)) ;;
  esac
  [ ${#names[@]} -gt 0 ] || return 0
  n=$(find /tmp -mindepth 1 -maxdepth 1 \( "${names[@]:1}" \) -print -exec rm -rf {} + 2>/dev/null | wc -l)
  [ "$n" -gt 0 ] && echo "== /tmp: cleared $n entries earlier sessions left"
  return 0
}
[ -z "${BL_INSIDE:-}" ] && clear_stale_tmp

# Until the runtime is stable, Steam's own logs are copied beside the session log at exit so a
# failed launch can be handed over as one folder.
collect_steam_logs() {
  [ -n "${BL_DEBUG_DIR:-}" ] || return 0
  local steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
  mkdir -p "$BL_DEBUG_DIR/steam" 2>/dev/null || return 0
  # Into steam/ beside this session's own logs. The app scrubs these line by line after the
  # session ends - they carry the account's session token and id - so nothing here is the last
  # word on what the user ends up sharing; this is just the copy that survives the runtime.
  # Up to 8 MB each, as the app's own copy takes them: the client's CEF and *.previous.txt logs
  # reach 17 MB and say little about this session, and every share scrubs whatever is here.
  [ -d "$steam_root/logs" ] && find "$steam_root/logs" -maxdepth 1 -type f -size -8192k \
    -exec cp {} "$BL_DEBUG_DIR/steam/" \; 2>/dev/null
  [ -f "$HOME/.steam/steam/logs/steamwebhelper.log" ] && cp "$HOME/.steam/steam/logs/steamwebhelper.log" "$BL_DEBUG_DIR/steam/" 2>/dev/null
  # Proton's own log, when BL_PROTON_LOG=1 asked for it. It is pointed at this folder through
  # PROTON_LOG_DIR; a Proton that does not read that writes steam-<appid>.log in $HOME instead,
  # and that is still the only thing that says why a game stopped.
  find "$HOME" -maxdepth 1 -type f -name 'steam-*.log' -size -8192k \
    -exec cp {} "$BL_DEBUG_DIR/steam/" \; 2>/dev/null
  # One past that is trimmed to its end instead of dropped, which is what the app now does with a
  # big log in this folder when it shares it: a run with +loaddll writes more than 8 MB, and this
  # log's answer to why a game stopped is its last lines, never its first.
  find "$HOME" -maxdepth 1 -type f -name 'steam-*.log' ! -size -8192k -print 2>/dev/null \
  | while IFS= read -r proton_log; do
      { echo "... (this log was trimmed: only its last 8 MB are here)"
        tail -c 8388608 "$proton_log" | tail -n +2; } > "$BL_DEBUG_DIR/steam/${proton_log##*/}" 2>/dev/null
    done
  # NOT copied, ever: loginusers.vdf, config.vdf and the ssfn* files, which hold the credentials
  # themselves rather than a mention of them.
  local sync_store=$HOME/.local/share/droiddeck-esync sync_file
  if [ -d "$sync_store" ] && mkdir -p "$BL_DEBUG_DIR/droiddeck-esync" 2>/dev/null; then
    for sync_file in launches.log tools.tsv wanted.tsv prefixes.json; do
      [ -f "$sync_store/$sync_file" ] && cp "$sync_store/$sync_file" "$BL_DEBUG_DIR/droiddeck-esync/" 2>/dev/null
    done
  fi
  local fex_state=$HOME/.local/share/droiddeck-fex
  if [ -d "$fex_state" ] && mkdir -p "$BL_DEBUG_DIR/droiddeck-fex" 2>/dev/null; then
    cp "$fex_state/status.json" "$fex_state/config/Config.json" "$BL_DEBUG_DIR/droiddeck-fex/" 2>/dev/null
  fi
  echo "== steam logs copied to $BL_DEBUG_DIR/steam"
}
# A session that is killed never reaches the copy below, and those are the sessions worth reading.
trap 'collect_steam_logs 2>/dev/null || true' TERM INT HUP
# The driver everything in this session draws with: gamescope's compositing, the client's UI
# (OpenGL through Zink), every game Proton launches, and in desktop mode every program on it.
# BL_VK_DRIVER names an imported driver's ICD manifest on the Android side, which is bound into the
# session at its own path; unset means the runtime keeps the Turnip it was built with.
# VK_DRIVER_FILES REPLACES the loader's search, so a manifest whose library is unreadable would
# leave the session with no Vulkan at all - check both before setting it, and say so in the log
# rather than fail silently half a minute later.
# GPU safety (BL_GPU_SAFETY): "software" means the app has kept the device's own GPU out of the
# guest - no /dev/mali0, no render node - and the session draws with an imported CPU driver
# (lavapipe). Nothing here asks the GPU for anything in that mode: no probe, no PanVK requirement.
software=no
[ "${BL_GPU_SAFETY:-}" = software ] && software=yes
if [ "$software" = yes ]; then
  # A stat, not an open: what the guest sees where the device node would be. "no char device"
  # is the whole point, and it is what the app's bind was put there for.
  if [ -c /dev/mali0 ]; then
    echo "== gpu safety: SOFTWARE, but /dev/mali0 IS still a character device in the guest"
  else
    echo "== gpu safety: SOFTWARE - /dev/mali0 is not a character device in the guest"
  fi
  # What the node is in here, and how many the app meant to cover: with one hid and a character
  # device still in front of us, the bind is what failed, not the count.
  echo "== gpu safety: /dev/mali0 here is $(stat -c '%F, %s bytes' /dev/mali0 2>&1); the app hid ${BL_GPU_HIDDEN:-?} GPU node(s)"
fi
if [ "$software" != yes ] && [ "${BL_GPU_FAMILY:-}" = mali ] && [ -z "${BL_VK_DRIVER:-}" ]; then
  echo "DD_MALI_DRIVER_REQUIRED: import/select the Linux PanVK package; Turnip cannot run on Mali"
  exit 78
fi
if [ -n "${BL_VK_DRIVER:-}" ]; then
  bl_icd_lib=$(sed -n 's/.*"library_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$BL_VK_DRIVER" 2>/dev/null | head -1)
  # JSON may escape the separator: org.json writes "\/data\/user\/0\/...". The Vulkan loader
  # parses that correctly; this check has to as well, or an absolute path looks relative and gets
  # glued onto the manifest's directory - which is exactly what happened the first time.
  bl_icd_lib=$(printf '%s' "$bl_icd_lib" | sed 's|\\/|/|g')
  case $bl_icd_lib in
    /*) ;;
    ?*) bl_icd_lib="$(dirname "$BL_VK_DRIVER")/$bl_icd_lib" ;;
  esac
  if [ -r "$BL_VK_DRIVER" ] && [ -n "$bl_icd_lib" ] && [ -r "$bl_icd_lib" ]; then
    export VK_DRIVER_FILES="$BL_VK_DRIVER"
    # Loaders older than 1.3.207 only know the old name; both are harmless together.
    export VK_ICD_FILENAMES="$BL_VK_DRIVER"
    echo "== vulkan driver: imported $bl_icd_lib (via $BL_VK_DRIVER)"
  else
    if [ "$software" = yes ]; then
      echo "DD_SOFTWARE_BAD_ICD: manifest or library is unreadable: $BL_VK_DRIVER"
      exit 78
    fi
    if [ "${BL_GPU_FAMILY:-}" = mali ]; then
      echo "DD_MALI_BAD_ICD: manifest or backend wrapper is unreadable: $BL_VK_DRIVER"
      exit 78
    fi
    echo "== vulkan driver: IGNORING $BL_VK_DRIVER (manifest or ${bl_icd_lib:-library} unreadable); using the runtime's own"
  fi
  unset bl_icd_lib
fi
# The Mali probe loads the imported ICD and enumerates devices: GPU work, and the one thing
# software mode exists to avoid. Skipped there; it also never runs inside gamescope's own pass.
if [ "$software" != yes ] && [ "${BL_GPU_FAMILY:-}" = mali ] && [ -z "${BL_INSIDE:-}" ]; then
  /usr/local/bin/droiddeck-mali-check || exit 78
fi
# What the driver's WSI was told to be: 1 = dma-buf + AFBC (the fast path), 0 = CPU/SHM linear
# copies. Wrong here reads straight off the fps - worth one line beside the driver's own.
if [ "$software" != yes ] && [ "${BL_GPU_FAMILY:-}" = mali ]; then
  echo "== mali wsi: PANVK_KBASE_DRI3=${PANVK_KBASE_DRI3:-unset} (1 = dma-buf/AFBC, 0 = shm copies)"
  echo "== mali sema-waits: PANVK_KBASE_GPU_SEMAPHORE_WAITS=${PANVK_KBASE_GPU_SEMAPHORE_WAITS:-unset} (1 = waits inside the submit ring; Download/droiddeck-mali-semawaits=0 undoes it)"
  if [ -n "${PANVK_BC_AFRC:-}" ]; then
    echo "== mali bc: PANVK_BC_AFRC=${PANVK_BC_AFRC} (0 = exact BC decode; Download/droiddeck-mali-afrc or the game page set it)"
  fi
  # Games' present path. The gamescope WSI layer (the XWayland-bypass swapchain) hung after the
  # first frame on both 2026-10-12 and 2026-10-14 sessions: swapchain created, no error back,
  # audio and input alive, picture frozen at the game's logo. It never reads PANVK_KBASE_DRI3,
  # which is why the dma-buf store fix left games untouched. With the layer bypassed a game
  # presents through panvk's own X11 DRI3 - the transport the client and gamescope's output
  # already use - and the app sends BL_MALI_GAMESCOPE_WSI=0 for that (1 = the layer, for a
  # controlled experiment; unset here defaults to the bypass too).
  case "${BL_MALI_GAMESCOPE_WSI:-0}" in
    1) echo "== mali games: gamescope WSI layer ON (Download/droiddeck-mali-gamescope-wsi)" ;;
    *) export DISABLE_GAMESCOPE_WSI=1
       echo "== mali games: gamescope WSI layer bypassed - games present via X11 DRI3 (Download/droiddeck-mali-gamescope-wsi=1 puts it back)" ;;
  esac
fi
# The app's gamescope build (tools/gamescope) asks for realtime-priority Vulkan queues on this
# switch instead of on CAP_SYS_NICE, which proot never has; it falls back to normal priority
# where the driver refuses, and the runtime's own build ignores it. On KGSL Turnip (Mesa 26.2) it
# changes nothing yet: the driver reports one submit-queue priority and creates every KGSL context
# with the same flags, so no priority reaches the GPU. Kept for a driver that maps it, and off
# unless the app's Performance page turns it on (BL_GAMESCOPE_REALTIME=1).
export GAMESCOPE_FORCE_VULKAN_REALTIME=${BL_GAMESCOPE_REALTIME:-0}

# A sleep that starts no process. Under proot every exec is a traced execve plus the loader's
# opens and maps, and the watchers below poll for the whole session: `sleep 1` in a loop was 60
# execs a minute each. read -t on a pipe nothing ever writes to waits in bash itself.
# The agent bridge's guest side (docs/agent-control.md): runs what the app's agent provider asks
# for inside this session and publishes gamescope's focus. Its files live under the session root
# ($BL_LAUNCH_DIR/agent), which the app empties before each session.
start_agent() {
  [ -n "${BL_LAUNCH_DIR:-}" ] && [ -x /usr/local/bin/droiddeck-agent ] || return 0
  mkdir -p "$BL_LAUNCH_DIR/agent"
  /usr/local/bin/droiddeck-agent "$@" 2>&1 &
}
nap() {
  [ -n "${bl_nap_fd:-}" ] || exec {bl_nap_fd}<> <(:)
  read -r -t "$1" -u "$bl_nap_fd" _ 2>/dev/null || :
}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
if [ "$mode" = lxqt ] || [ "$mode" = desktop ]; then
  /usr/local/bin/droiddeck-desktop-bookmarks || true
fi
# Flatpak (the store's apps): its sandboxes through the app instead of bubblewrap, which needs the
# user namespaces Android keeps from apps, and its apps' menu entries and icons on the desktop.
export FLATPAK_BWRAP=/usr/local/bin/droiddeck-bwrap
export XDG_DATA_DIRS=$XDG_DATA_HOME/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}

# The cores a program runs on outside Steam (the desktop and everything started from it, a
# program from the rail): the user's game cores when set (BL_GAME_CPUS), else every core but the
# slowest cluster - Android is free to park an emulator's threads on the little cores, and those
# are what compile shaders and recompile PPU/SPU code. BL_PIN_CORES=0 leaves the scheduler alone.
program_cores() {
  [ "${BL_PIN_CORES:-1}" = 0 ] && return 0
  command -v taskset >/dev/null 2>&1 || return 0
  if [ -n "${BL_GAME_CPUS:-}" ]; then echo "$BL_GAME_CPUS"; return 0; fi
  local f n max min= list=
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
    max=$(cat "$f" 2>/dev/null) || continue
    [ -z "$min" ] || [ "$max" -lt "$min" ] && min=$max
  done
  [ -n "$min" ] || return 0
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
    max=$(cat "$f" 2>/dev/null) || continue
    n=${f#/sys/devices/system/cpu/cpu}; n=${n%%/*}
    [ "$max" -gt "$min" ] && list="$list${list:+,}$n"
  done
  echo "$list"
}

if [ -z "${BL_INSIDE:-}" ]; then
  # Install the shared default-family aliases before Steam, gamescope or the desktop queries fonts.
  /usr/local/bin/droiddeck-fonts 2>&1 | sed 's/^/[fonts] /'
  # Android's directory binding and language-specific family matches handle CJK and Thai fonts.
  device_fonts=/usr/local/share/fonts/android
  if [ -d "$device_fonts" ] && [ -d /etc/fonts/conf.d ] && command -v fc-cache >/dev/null 2>&1; then
    fonts_rules=$(
      echo '<?xml version="1.0"?><!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd"><fontconfig>'
      for pair in "zh-cn=Noto Sans CJK SC" "zh-sg=Noto Sans CJK SC" "zh-tw=Noto Sans CJK TC" "zh-hk=Noto Sans CJK HK" \
        "zh-mo=Noto Sans CJK HK" "ja=Noto Sans CJK JP" "ko=Noto Sans CJK KR" "th=Noto Sans Thai"; do
        printf '<match target="pattern"><test name="lang" compare="contains"><string>%s</string></test><edit name="family" mode="prepend_first"><string>%s</string></edit></match>\n' \
          "${pair%%=*}" "${pair#*=}"
      done
      echo '</fontconfig>'
    )
    fonts_conf=/etc/fonts/conf.d/66-droiddeck-device-fonts.conf
    [ "$fonts_rules" = "$(cat "$fonts_conf" 2>/dev/null)" ] || printf '%s\n' "$fonts_rules" > "$fonts_conf"
    fonts_seen=$(ls -lL "$device_fonts" 2>/dev/null | md5sum)
    fonts_stamp=/var/cache/fontconfig/.droiddeck-android-fonts
    if [ "$fonts_seen" != "$(cat "$fonts_stamp" 2>/dev/null)" ]; then
      fc-cache -f "${device_fonts%/*}" >/dev/null 2>&1 && printf '%s\n' "$fonts_seen" > "$fonts_stamp"
      echo "== fontconfig: indexed $(ls "$device_fonts" | wc -l) device fonts, zh falls back to $(fc-match -f '%{family[0]}' ':lang=zh-cn' 2>/dev/null)"
    fi
  fi
  # The compositor may still be starting, and a socket left by an earlier session is not
  # a compositor: probe until a connection succeeds.
  for _ in $(seq 1 100); do
    wayland-info >/dev/null 2>&1 && break
    sleep 0.1
  done
  # The desktop (DroidDeck's hosted package) is its own nested compositor, KWin, drawing straight
  # into the app's: no gamescope in between.
  if [ "$mode" = lxqt ]; then
    step "starting the desktop"
    start_agent --no-focus
    [ -x /usr/local/bin/droiddeck-desktop ] || { echo "== the desktop package is not installed"; exit 66; }
    cores=$(program_cores)
    if [ -n "$cores" ]; then
      echo "== desktop cores: $cores (the desktop and every program started from it)"
      # Pin this shell and let exec carry the mask. Android keeps the app on a smaller cpuset
      # until its activity is on top (foreground 0-5, background fewer), and a mask with no core
      # of that set is EINVAL: taskset -c then exits 1 and takes the whole session with it.
      taskset -cp "$cores" $$ >/dev/null 2>&1 || echo "== desktop cores: not allowed right now, every core"
    fi
    exec /usr/local/bin/droiddeck-desktop
  fi
  width=${BL_WIDTH:-1280}
  height=${BL_HEIGHT:-720}
  nested=$width
  # Follow screen (BL_FOLLOW_OUTPUT=1): the app resizes gamescope's output when a foldable opens or
  # closes, and with Steam on its own Xwayland gamescope resizes Steam's X screen with it, as on a
  # Steam Deck docking. A stretched 16:9 nested size would pin it, so the two are exclusive.
  if [ "${BL_FOLLOW_OUTPUT:-0}" = 1 ]; then
    echo "== gamescope: the output follows the screen (${width}x${height} to start)"
  elif [ "$mode" = steam ] && [ "${BL_GAMESCOPE_STRETCH_16X9:-0}" = 1 ]; then
    wide=$(( (height * 16 + 4) / 9 / 2 * 2 ))
    if [ "$wide" -gt "$width" ]; then
      nested=$wide
      echo "== gamescope: games at ${nested}x${height} stretched to the ${width}x${height} output"
    fi
  fi
  args=(--backend wayland --expose-wayland -f -W "$width" -H "$height" -w "$nested" -h "$height")
  [ "$nested" != "$width" ] && args+=(-S stretch) && export BL_STRETCHED=1
  # -r is what gamescope advertises as the refresh rate, and what a game reads as the display's.
  # Left unset it defaults to 60, so a 120 Hz panel offers only 60 Hz in game settings. The FPS
  # limiter wins when it is on (it is a deliberate cap); otherwise use the panel's own rate.
  if [ "${BL_FPS:-0}" -gt 0 ]; then
    args+=(-r "$BL_FPS")
    # The 2026-10-14 X6 Pro session ran with the limiter at 30 and its game read a 30 Hz display
    # (DXVK: "Reported refresh rate: 30.0 Hz"), which reads as a broken display when the complaint
    # is speed. Say it once, beside everything else.
    if [ "$mode" = steam ] && [ "${BL_FPS}" -lt 45 ]; then
      echo "== note: the app's FPS limiter is ${BL_FPS} - games see a ${BL_FPS} Hz display and cannot exceed it"
    fi
  elif [ "${BL_REFRESH:-0}" -gt 0 ]; then
    args+=(-r "$BL_REFRESH")
  fi
  [ "$mode" = steam ] && args+=(-e)
  # Two Xwayland servers, as SteamOS runs Steam: the client on the first, games on the second
  # (STEAM_GAME_DISPLAY_0). The client then sizes the games' server to each game's Game Resolution
  # (GAMESCOPE_XWAYLAND_MODE_CONTROL; native unless one is set), and gamescope scales it to the
  # output. With one server the client and its games share the output's size, so a game's own Game
  # Resolution never reaches its display (docs/development/steam-display-scaling.md). The client's
  # overlay is also on another server than the game, so opening it no longer takes the game's X
  # keyboard focus, which made games like FlatOut shrink their window.
  # One Xwayland server by default on this 7.1 GB Mali branch: a second Xwayland server loads a
  # second Mesa Zink + PanVK + Fossilize stack (~215 MB of RAM before a game even starts) and lets
  # STEAM_MULTIPLE_XWAYLANDS=1 override the game server's mode to 800x600@120 even when the session
  # is 960x720@30. BL_XWAYLAND_COUNT=2 in Download/droiddeck-env restores two servers.
  if [ "$mode" = steam ] && [ "${BL_XWAYLAND_COUNT:-1}" -gt 1 ]; then
    args+=(--xwayland-count "${BL_XWAYLAND_COUNT:-1}")
    export STEAM_MULTIPLE_XWAYLANDS=1
  fi
  # Touch passes through to the client as touch until the client says otherwise, as SteamOS's
  # gamescope-session starts it (TOUCH_MODE=4). The client sets the mode itself (STEAM_TOUCH_CLICK_MODE)
  # only once it has a controller; until then gamescope's own default made a finger a left-click
  # mouse, so the Steam interface took taps but would not scroll on a phone with no pad attached.
  [ "$mode" = steam ] && args+=(--default-touch-mode 4)
  # No --force-windows-fullscreen: it was for games that shrink their window when the Steam menu
  # opens over them (FlatOut), which no longer happens with the games on their own Xwayland server
  # (above), and it made any game drawing at another size than its display fight it. An experiment
  # can still pass it with BL_GAMESCOPE_ARGS.
  # HDR10: the app opened its compositor's colour-management gate for this session (BL_HDR=1);
  # gamescope then offers HDR to its clients through the same wp_color_manager_v1 it binds on ours.
  [ "${BL_HDR:-0}" = 1 ] && args+=(--hdr-enabled)
  # Extra gamescope arguments for an experiment (--debug-focus, say), from Download/droiddeck-env.
  [ -n "${BL_GAMESCOPE_ARGS:-}" ] && read -r -a _bl_extra <<<"$BL_GAMESCOPE_ARGS" && args+=("${_bl_extra[@]}")
  # Deck mode's performance overlay (Quick Access Menu → Performance → Overlay Level) is drawn by
  # mangoapp, which gamescope starts beside the client; the client sets the level by rewriting
  # MANGOHUD_CONFIGFILE. The apk stages Valve's aarch64 build (tools/mangoapp) - without it the menu
  # still offers the levels and nothing appears. Starts hidden until the client writes a level.
  # BL_MANGOAPP=0 turns it off (one community build found Valve's mangoapp crashing on Turnip).
  if [ "$mode" = steam ] && [ "${BL_STEAMDECK:-0}" = 1 ] && [ "${BL_MANGOAPP:-1}" = 1 ] \
     && [ "${BL_STEAM_UI:-}" != desktop ] && command -v mangoapp >/dev/null 2>&1; then
    # One fixed file, rewritten each session: a mktemp name per session was never removed.
    MANGOHUD_CONFIGFILE=/tmp/droiddeck-mangohud.conf
    echo no_display > "$MANGOHUD_CONFIGFILE"
    export MANGOHUD_CONFIGFILE STEAM_USE_MANGOAPP=1 STEAM_MANGOAPP_PRESETS_SUPPORTED=1 STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1
    args+=(--mangoapp)
    echo "== gamescope: mangoapp on ($(command -v mangoapp), config $MANGOHUD_CONFIGFILE)"
  fi
  export BL_INSIDE=1
  if [ "$software" = yes ]; then
    # gamescope composites on the GPU and cannot do without one: it imports the client's buffers
    # as dma-bufs and synchronises with sync files (VK_KHR_external_semaphore_fd, VK_EXT_image_
    # drm_format_modifier), none of which lavapipe has - it names the missing extension and
    # exits, as a session log on a Mali phone showed. Software mode therefore runs the session's
    # program straight into the app's compositor, with Xwayland where gamescope would have been.
    echo "== software: gamescope needs a GPU and is skipped; Xwayland takes its place"
    if ! command -v Xwayland >/dev/null 2>&1; then
      echo "DD_SOFTWARE_NO_XWAYLAND: this runtime has no Xwayland, so nothing can be displayed"
      exit 66
    fi
    # -geometry, not -screen: this Xwayland takes the size of its window from -geometry and
    # rejects -screen outright ("Unrecognized option: -screen", fatal) - which is how the first
    # software session ended, with Steam unable to open a display.
    # No display number of our own, and -displayfd instead of -nolock: the server takes the first
    # free display and writes its number to the fd, and -displayfd is what turns the lock off -
    # xserver sets nolock for it (os/utils.c) for any user. -nolock itself is refused to everyone
    # but root ("Warning: the -nolock option can only be used by root", and this session runs as
    # uid 10370), and the lock then cannot be linked into place under proot either:
    # "Linking lock file (/tmp/.X1-lock) in place failed: Operation not permitted", fatal. It is
    # how gamescope starts its own Xwaylands, which is why they come up where ours did not.
    _bl_xdisplay=$(mktemp "${BL_DEBUG_DIR:-/tmp}/xwayland-display.XXXXXX")
    Xwayland -geometry "${width}x${height}" -nolisten tcp -displayfd 3 3>"$_bl_xdisplay" \
      >>"${BL_DEBUG_DIR:-/tmp}/xwayland.log" 2>&1 &
    for _ in $(seq 1 100); do [ -s "$_bl_xdisplay" ] && break; sleep 0.1; done
    _bl_xnum=$(tr -cd 0-9 < "$_bl_xdisplay")
    rm -f "$_bl_xdisplay"
    if [ -z "$_bl_xnum" ]; then
      echo "DD_SOFTWARE_XWAYLAND_FAILED: Xwayland never answered; see xwayland.log"
      exit 66
    fi
    for _ in $(seq 1 100); do [ -S "/tmp/.X11-unix/X$_bl_xnum" ] && break; sleep 0.1; done
    export DISPLAY=:$_bl_xnum
    echo "== software: Xwayland on $DISPLAY at ${width}x${height}, a client of ${WAYLAND_DISPLAY:-no compositor}"
  else
    exec gamescope "${args[@]}" -- "$0" "$mode" "$@"
  fi
fi

# gamescope manages X windows: toolkits go through Xwayland, not gamescope's own Wayland socket.
# Root-window requests for the game (restore) go to every display gamescope gave us:
# the client's ($DISPLAY) and, with two servers, the games' (STEAM_GAME_DISPLAY_0); gamescope reads
# them per server.
bl_displays() {
  printf '%s\n' "$DISPLAY"
  [ -n "${STEAM_GAME_DISPLAY_0:-}" ] && [ "$STEAM_GAME_DISPLAY_0" != "$DISPLAY" ] && printf '%s\n' "$STEAM_GAME_DISPLAY_0"
  return 0
}
bl_xprop_set_all() {
  local d ok=1
  for d in $(bl_displays); do
    DISPLAY=$d xprop -root -f "$1" 32c -set "$1" "$2" 2>/dev/null || ok=0
  done
  [ "$ok" = 1 ]
}
export GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb SDL_VIDEODRIVER=x11
# gamescope's reaper waits for every process left under it before the compositor comes down. A
# process a game left behind - a Wine service blocked on a server that is already gone - is
# reparented there when the client exits, and the screen stays black on it for good. Nothing of
# the session outlives the program it was started for.
reap_orphans() {
  local round p stat pid left
  for round in 1 2 3 4 5; do
    left=
    for p in /proc/[0-9]*; do
      pid=${p#/proc/}
      [ "$pid" = "$$" ] && continue
      stat=$(cat "$p/stat" 2>/dev/null) || continue
      stat=${stat##*) }
      set -- $stat
      [ "${2:-}" = "$PPID" ] && left="$left $pid"
    done
    [ -n "$left" ] || return 0
    echo "== leaving behind:$left"
    kill -9 $left 2>/dev/null
    sleep 0.2
  done
}

# Gamescope's Wayland backend does not forward the outer clipboard into Xwayland.
# This helper owns only Android text selections and exits with this guest session.
if [ -n "${BL_ANDROID_CLIPBOARD:-}" ] && [ -x /usr/local/bin/droiddeck-clipboard ]; then
  /usr/local/bin/droiddeck-clipboard "$BL_ANDROID_CLIPBOARD" &
fi

start_agent

case $mode in
  desktop)
    exec pcmanfm
    ;;
  run)
    target=${1:?program path}
    shift
    cores=$(program_cores)
    if [ -n "$cores" ]; then
      echo "== program cores: $cores"
      taskset -cp "$cores" $$ >/dev/null 2>&1 || true
    fi
    # Player 1 on the controller in an emulator that has no profile of its own yet.
    python3 /usr/local/bin/droiddeck-pad-defaults 2>&1 || true
    # A launch whose target never shows up dies here with a line the front end can read, not a
    # bare "No such file or directory" from exec (the same words a missing ELF interpreter gets).
    [ -e "$target" ] || { echo "== run: $target does not exist in the guest; stage it again"; exit 127; }
    [ -s "$target" ] || { echo "== run: $target is empty; pick it again"; exit 126; }
    fex=()
    if [ -x /usr/local/bin/droiddeck-fex ]; then
      case $(od -An -tu2 -j18 -N2 "$target" 2>/dev/null | tr -d ' ') in
        3|62) fex=(/usr/local/bin/droiddeck-fex run --mode on --) ;;
      esac
    fi
    case ${target,,} in
      *.appimage)
        export APPIMAGE_EXTRACT_AND_RUN=1
        chmod +x "$target" 2>/dev/null
        # AppImages are decided by droiddeck-fex itself (mode auto: its own ELF read sends x86_64
        # to FEX and an ARM AppImage runs native, and an uninstalled FEX says so in words). The
        # od probe above has no say here - a read it missed used to exec the image raw, and the
        # kernel answered with the same "No such file or directory" as a missing interpreter.
        if [ -x /usr/local/bin/droiddeck-fex ]; then
          exec /usr/local/bin/droiddeck-fex run --mode auto -- "$target" "$@"
        fi
        exec "$target" "$@"
        ;;
      *.sh)
        if [ -x /usr/local/bin/droiddeck-fex ]; then
          exec /usr/local/bin/droiddeck-fex run --for "$target" -- bash "$target" "$@"
        fi
        exec bash "$target" "$@"
        ;;
      *)
        chmod +x "$target" 2>/dev/null
        cd "$(dirname "$target")" && exec "${fex[@]}" "$target" "$@"
        ;;
    esac
    ;;
  steam)
    step "checking the Steam client (first run downloads it, ~1-2 min with nothing on screen)"
    droiddeck-steam-install || exit $?
    step "Steam client ready"
    steam_root=$XDG_DATA_HOME/Steam
    # Register the card library (bound at /mnt/droiddeck-sd) with the client - internal storage is
    # its main library already - and the ARM64 Proton that lets it launch the Windows ones.
    # A request left in ~/.bl-proton-extra installs a third-party Proton before the client starts,
    # so it is in the Compatibility dropdown the first time the user looks. One per line, each the
    # arguments to droiddeck-proton-extra: "ge", "cachyos", "ge --tag GE-Proton11-7", or a URL.
    # Hundreds of megabytes each, so it is only ever done on request, and the line is dropped once
    # it has succeeded - a failed download stays and is retried next session.
    if [ -s "$HOME/.bl-proton-extra" ]; then
      _bl_left=$HOME/.bl-proton-extra.left
      : > "$_bl_left"
      while read -r _bl_extra || [ -n "$_bl_extra" ]; do
        case ${_bl_extra# } in ""|"#"*) continue ;; esac
        step "installing Proton '$_bl_extra' (large download, several minutes)"
        if droiddeck-proton-extra "$steam_root" $_bl_extra; then
          step "installed Proton '$_bl_extra'"
        else
          step "Proton '$_bl_extra' failed; will retry next session"
          echo "$_bl_extra" >> "$_bl_left"
        fi
      done < "$HOME/.bl-proton-extra"
      mv -f "$_bl_left" "$HOME/.bl-proton-extra"
    fi
    # steam:// URLs left in ~/.bl-steam-urls are handed to the client on its command line. The app
    # writes one when the user asks for a Proton that is one of Valve's own depots rather than a
    # tarball: those are not files anywhere, the client fetches them like any other app. One per
    # line, and the file is cleared once they have been passed on - the client either acts on a URL
    # or it does not, and repeating it every session would re-ask forever.
    if [ -s "$HOME/.bl-steam-urls" ]; then
      while read -r _bl_url || [ -n "$_bl_url" ]; do
        case ${_bl_url# } in steam://*) ;; *) continue ;; esac
        step "asking the client for $_bl_url"
        set -- "$@" "$_bl_url"
      done < "$HOME/.bl-steam-urls"
      rm -f "$HOME/.bl-steam-urls"
    fi
    # Cores for the client itself. Steam pins its own interface renderer to a subset - on the
    # device it took 5 of 8, leaving out both little cores and the fastest one - which is a
    # reasonable thing to do while a game is running and the wrong thing when the client is all
    # there is. BL_CLIENT_CPUS overrides it. Re-applied on a beat because steamwebhelper spawns
    # children continuously and each one inherits Steam's choice, not ours. The beat reads /proc
    # itself instead of running pgrep, and only runs taskset for a process that is new or has
    # grown threads since it was last pinned: every fork is a round of traced syscalls, and a
    # beat that forked a taskset per process every 5 s did that for an hour. taskset -a, because
    # without it only a process's main thread moves and the renderer's workers stay where they were.
    if [ -n "${BL_CLIENT_CPUS:-}" ]; then
      step "client cores: $BL_CLIENT_CPUS"
      (
        declare -A _bl_pinned=()
        for ((_i = 0; _i < 720; _i++)); do
          for _d in /proc/[0-9]*; do
            { IFS= read -r -d '' _c < "$_d/cmdline"; } 2>/dev/null || continue
            case $_c in *steamwebhelper*|*steamrtarm64/steam|*gamescope*) ;; *) continue ;; esac
            _t=("$_d"/task/*)
            _p=${_d#/proc/}
            [ "${_bl_pinned[$_p]:-}" = "${#_t[@]}" ] && continue
            taskset -a -cp "$BL_CLIENT_CPUS" "$_p" >/dev/null 2>&1 || true
            _bl_pinned[$_p]=${#_t[@]}
          done
          nap 5
        done
      ) &
    fi

    step "registering the app's game library with Steam"
    droiddeck-steam-library "$steam_root" || true
    step "setting up the ARM64 Proton compatibility tool"
    steam-compatibility "$steam_root" || true
    if [ -z "${BL_DESKTOP:-}" ] && [ "${BL_STEAM_UI:-}" != desktop ]; then
      droiddeck-steam-ui-scale "$steam_root" "${BL_WIDTH:-1280}" "${BL_HEIGHT:-720}" || true
    fi
    # The user's own games, as non-Steam shortcuts under that tool; the list is written by the app
    # each session (empty = the app's earlier entries are removed, the client's own are kept).
    if [ -n "${BL_ADDED_GAMES:-}" ]; then
      step "adding the app's own games to the client's library"
      droiddeck-steam-shortcuts "$steam_root" "$BL_ADDED_GAMES" || true
    fi
    # Steam runs a game's shared redistributables inside its prefix on first launch; marking
    # them as already run keeps those x86 installers from starting under emulation at all.
    droiddeck-seed-redists "$steam_root" || true
    # The compatibility tool runs Valve's arm64 Proton, which the client fetches like any depot.
    # Asked for on the command line the first time, so a Windows title has it before it is needed.
    if [ ! -f "$steam_root/steamapps/appmanifest_4427310.acf" ]; then
      step "asking the client to fetch the ARM64 Proton"
      set -- "$@" steam://install/4427310
      # Ported from Bannerlator's session script (device-proven 2026-09-22). The client decides
      # a title's compatibility tool when the title is installed and keeps that decision for the
      # rest of its run, and the tool is set up before the client comes up. So once the depot has
      # fully landed, restart the client once - its own -shutdown, then the loop below, which knows
      # the marker - and every title installed from then on runs through the tool, with the
      # refreshed tool list and defaults, and no second launch by the user. A first run only: with
      # the depot present at session start nothing here is armed.
      (
        _bl_acf="$steam_root/steamapps/appmanifest_4427310.acf"
        for _ in $(seq 1 360); do
          sleep 10
          # StateFlags 4 = fully installed; a moment more for the client to finish its bookkeeping.
          if grep -q '"StateFlags"[[:space:]]*"4"' "$_bl_acf" 2>/dev/null; then
            sleep 10
            steam-compatibility "$steam_root" >/dev/null 2>&1 || true
            step "compatibility layer installed: restarting the Steam client once"
            : > "$HOME/.bl-restart-once"
            "$steam_root/steamrtarm64/steam" -shutdown >/dev/null 2>&1 || true
            exit 0
          fi
        done
      ) &
      # A client that starts signed out drops that request - on a fresh install nobody has signed
      # in yet - so the install dialog only appeared after the user restarted the client by hand.
      # With no remembered sign-in, ask again once the sign-in has happened: the client binary
      # started a second time with a URL hands it to the running instance and exits.
      #
      # The request is also dropped while the client is still in its post-logon compat phase (it
      # probes every registered tool then): with publicbeta 1790380355 that phase took 27 s and a
      # request sent 15 s after sign-in vanished (2026-09-26, no dialog; 1790121765 was done in
      # time). So wait for the client to say the phase is over ("Waiting for compat in post-logon
      # took" in its console log; at most 90 s if it never does), then ask - and ask again, twice
      # at most, if no install has started a minute later.
      if ! grep -q '"RememberPassword"[[:space:]]*"1"' "$steam_root/config/loginusers.vdf" 2>/dev/null; then
        (
          _bl_acf="$steam_root/steamapps/appmanifest_4427310.acf"
          _bl_conn="$steam_root/logs/connection_log.txt"
          _bl_cons="$steam_root/logs/console_log.txt"
          _bl_from=$(stat -c %s "$_bl_conn" 2>/dev/null || echo 0)
          _bl_cfrom=$(stat -c %s "$_bl_cons" 2>/dev/null || echo 0)
          for _ in $(seq 1 180); do
            sleep 10
            [ -f "$_bl_acf" ] && exit 0
            if tail -c +$((_bl_from + 1)) "$_bl_conn" 2>/dev/null | grep -q "RecvMsgClientLogOnResponse() : processing complete"; then
              for _ in $(seq 1 45); do
                tail -c +$((_bl_cfrom + 1)) "$_bl_cons" 2>/dev/null | grep -q "Waiting for compat in post-logon took" && break
                sleep 2
              done
              for _bl_try in 1 2 3; do
                sleep 10
                [ -f "$_bl_acf" ] && exit 0
                step "signed in: asking the client again for the ARM64 Proton (try $_bl_try of 3)"
                "$steam_root/steamrtarm64/steam" steam://install/4427310 >/dev/null 2>&1 || true
                sleep 50
              done
              exit 0
            fi
          done
        ) &
      fi
    fi
    # The tool is registered before the client starts and finds the depot at launch time, so
    # nothing here waits for a download. What can still change under a running client is which
    # titles are installed: a title installed this session gets the client's own per-app Proton
    # choice, which it cannot start. Refresh the per-app entries every so often; the registrar is
    # idempotent, so a repeat costs nothing.
    # The seeder has the same problem and a worse consequence. It marks the shared redistributables
    # as already run in each prefix that exists, and a game's prefix is not created until the
    # client launches it - so a title played for the first time this session was never covered, and
    # its install scripts run for real. That is exactly the hang the seeder exists to prevent: Need
    # for Speed Payback sat on "Running install script" with vcredist_x86.exe blocked in pipe_read,
    # holding both ends of a pipe nobody would write to, while the client waited for it to exit.
    # Seeding again on the same beat covers a prefix the moment it appears.
    # The seeder runs on a shorter beat than the registrar because it is racing something. The
    # client creates a prefix when it launches a title and runs that title's install scripts
    # moments later, so the seeder has only that gap to mark the redistributables as already run.
    # It stamps each prefix it has covered and skips it thereafter, so the extra passes cost
    # almost nothing.
    # With the 16:9 stretch on, the client's own scaler must not undo it: in Deck mode it sets
    # GAMESCOPE_NEW_SCALING_SCALER to Auto (0), which fits the 16:9 picture with bars and outranks -S.
    # Auto is put back to Stretch (4); a mode picked in the QAM (Integer, Fit, Fill) is kept.
    [ -z "${BL_DESKTOP:-}" ] && [ "${BL_STRETCHED:-0}" = 1 ] && (
      while :; do
        nap 1
        cur=$(xprop -root GAMESCOPE_NEW_SCALING_SCALER 2>/dev/null) || continue
        case $cur in *" = "*) cur=${cur##* = } ;; *) cur=0 ;; esac
        [ "$cur" = 0 ] || continue
        xprop -root -f GAMESCOPE_NEW_SCALING_SCALER 32c -set GAMESCOPE_NEW_SCALING_SCALER 4 2>/dev/null \
          && echo "== stretch 16:9 to panel: the client's scaler was Auto, set to Stretch"
      done
    ) &
    # Resume from the Steam menu. The menu is an overlay that takes input, and a fullscreen game that
    # loses input minimizes itself; gamescope only takes a window out of that state when the focused
    # window changes, which the menu never does, so the game stayed minimized after Resume (a black
    # screen with its small caption in the top-left corner). gamescope-3.16.29-p4 restores it itself;
    # this asks it again a moment after input comes back from the client (app 769) to anything else,
    # which covers a game that minimizes late. Harmless when nothing is minimized.
    # BL_RESTORE_ON_RESUME=0 turns it off.
    [ -z "${BL_DESKTOP:-}" ] && [ "${BL_RESTORE_ON_RESUME:-1}" = 1 ] && (
      prev=
      xprop -spy -root GAMESCOPE_FOCUSED_APP 2>/dev/null | while read -r line; do
        app=${line##*= }
        case $app in ''|*[!0-9]*) prev=; continue ;; esac
        if [ "$prev" = 769 ] && [ "$app" != 769 ]; then
          nap 1
          bl_xprop_set_all GAMESCOPE_RESTORE_FOCUS_WINDOW 1 \
            && echo "== resume: asked gamescope to restore the game window (app $app)"
        fi
        prev=$app
      done
    ) &
    # Evidence for touch reports: the touch mode the client asks gamescope for (STEAM_TOUCH_CLICK_MODE,
    # set once it has a controller, per focused app) and which app has focus, logged as they change.
    # A finger that clicks but won't scroll, or touch that stops once a pad is used, shows here as
    # the mode in force at that moment. 4 is touch passed through, 1 a left-click mouse.
    [ -z "${BL_DESKTOP:-}" ] && (
      # What follows "=" in an xprop line, or $2 for a property that is missing or has no value
      # yet ("NAME(CARDINAL) =", which read leaves with nothing after the "=").
      xprop_value() {
        case $1 in *'not found'*|*=) echo "$2"; return ;; esac
        local v=${1#*=}
        v=${v# }
        echo "${v:-$2}"
      }
      tmode= app=
      xprop -spy -root STEAM_TOUCH_CLICK_MODE GAMESCOPE_FOCUSED_APP 2>/dev/null | while read -r line; do
        case $line in
          STEAM_TOUCH_CLICK_MODE*)
            v=$(xprop_value "$line" unset)
            [ "$v" = "$tmode" ] && continue
            tmode=$v
            echo "== touch mode: $tmode (focused app ${app:-?}) at $(date +%T)"
            ;;
          GAMESCOPE_FOCUSED_APP*)
            v=$(xprop_value "$line" none)
            [ "$v" = "$app" ] && continue
            app=$v
            echo "== focused app: $app (touch mode ${tmode:-unset}) at $(date +%T)"
            ;;
        esac
      done
    ) &
    # The library beat. Both helpers are whole programs under proot (the compat one a python
    # start and a parse of the client's config), and nearly every beat has nothing new for them.
    # The seeder marks Proton's prefix template as well as the prefixes, so a new prefix is born
    # marked and every 15 s is soon enough for the rest. The compat pass runs when a directory it
    # reads from has changed since its last run - a new manifest, a new depot or tool, the client
    # rewriting config.vdf - which [ -nt ] answers without starting anything, and once a minute
    # regardless.
    (
      beat=0
      compat_stamp=$HOME/.bl-compat-beat
      rm -f "$compat_stamp"
      compat_due() {
        local d
        [ -e "$compat_stamp" ] && [ "$((beat % 12))" -ne 0 ] || return 0
        for d in "$steam_root/steamapps" "$steam_root/steamapps/common" "$steam_root/config" \
                 "$steam_root/compatibilitytools.d" /mnt/droiddeck-sd/steamapps /root/Games/*/steamapps; do
          [ "$d" -nt "$compat_stamp" ] && return 0
        done
        return 1
      }
      for ((_i = 0; _i < 720; _i++)); do
        nap 5
        beat=$((beat + 1))
        [ "$((beat % 3))" -eq 0 ] || continue
        droiddeck-seed-redists "$steam_root" >/dev/null 2>&1 || true
        if compat_due; then
          : > "$compat_stamp"
          steam-compatibility "$steam_root" >/dev/null 2>&1 || true
        fi
      done
    ) &
    # A game the app asked to launch on a cold start is not put on the client's command line: the
    # client takes it before its interface is up, its launch stops at "waiting for user response to
    # ShowInterstitials" with nobody to answer, and the game page reads Launching for ever (device,
    # 2026-10-09, and 2026-10-08 before it). It is handed over once the interface has focus
    # (gamescope's focused app 769) and has had a moment, through the same steam-game request an
    # in-session launch uses; after two minutes it goes anyway.
    if [ -n "${BL_LAUNCH_DIR:-}" ] && [ -z "${BL_DESKTOP:-}" ]; then
      _bl_held=
      _bl_rest=()
      for _bl_arg in "$@"; do
        case $_bl_arg in
          steam://rungameid/*) _bl_held=${_bl_arg#steam://rungameid/} ;;
          *) _bl_rest+=("$_bl_arg") ;;
        esac
      done
      if [ -n "$_bl_held" ]; then
        set -- "${_bl_rest[@]}"
        (
          _bl_end=$((SECONDS + 120))
          until [ "$(xprop -root GAMESCOPE_FOCUSED_APP 2>/dev/null | sed -n 's/.*= *//p')" = 769 ] || [ "$SECONDS" -ge "$_bl_end" ]; do
            sleep 1
          done
          sleep 4
          echo "== steam: interface up; launching the requested game $_bl_held"
          printf '%s\n' "$_bl_held" > "$BL_LAUNCH_DIR/steam-game.tmp" && mv -f "$BL_LAUNCH_DIR/steam-game.tmp" "$BL_LAUNCH_DIR/steam-game"
        ) &
      fi
    fi
    # Debug aid while the runtime is being brought up: an app id dropped in ~/.bl-autolaunch is
    # handed to the client as a rungameid URL, so a launch can be reproduced without touching the
    # screen. Removed once the runtime is stable.
    if [ -s "$HOME/.bl-autolaunch" ]; then
      _bl_app=$(cat "$HOME/.bl-autolaunch")
      # A bare app id runs the game; a full steam:// URL is passed through, which is how a
      # validate or an install is driven without touching the screen.
      case $_bl_app in
        steam://*) _bl_url=$_bl_app ;;
        *) _bl_url=steam://rungameid/$_bl_app ;;
      esac
      echo "== autolaunch $_bl_url"
      set -- "$@" "$_bl_url"
    fi
    # The client builds Settings > Internet and its connection indicator on NetworkManager, which
    # it looks for on the SYSTEM bus as it starts. This runtime has neither, so the page failed
    # ("StartScanningForNetworks is not a function") under a header that showed no connection even
    # while downloads ran. A system bus and a stand-in that reports Android's connection - and
    # refuses what it cannot do, since the app has no say over Wi-Fi - answer what the client asks.
    # The bus config is written here rather than shipped, so a runtime installed earlier gets this
    # from the app's copy of the session scripts without a re-host. (WinNative, maxjivi05, e7a224ae.)
    if command -v dbus-daemon >/dev/null 2>&1 && command -v droiddeck-netmanager >/dev/null 2>&1; then
      mkdir -p /run/dbus /usr/local/share/droiddeck
      cat > /usr/local/share/droiddeck/system-bus.conf <<'BUSCONF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=/run/dbus/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
BUSCONF
      rm -f /run/dbus/system_bus_socket
      dbus-daemon --config-file=/usr/local/share/droiddeck/system-bus.conf --nofork --nopidfile &
      system_bus=$!
      for _ in $(seq 1 50); do
        [ -S /run/dbus/system_bus_socket ] && break
        sleep 0.1
      done
      if [ -S /run/dbus/system_bus_socket ]; then
        droiddeck-netmanager &
        netmanager=$!
        echo "== network: system bus up, NetworkManager stand-in running"
        # Steam blanks its main UI before calling login1.Suspend. Without the
        # matching resume notification it stays black although the menus work.
        # Own the name before Steam constructs its login1 proxy at startup.
        rm -f "$BL_LAUNCH_DIR/steam-sleep-ready"
        droiddeck-login1 &
        login_manager=$!
        for ((_i = 0; _i < 50; _i++)); do
          [ -f "$BL_LAUNCH_DIR/steam-sleep-ready" ] && break
          kill -0 "$login_manager" 2>/dev/null || break
          nap 0.1
        done
        if [ ! -f "$BL_LAUNCH_DIR/steam-sleep-ready" ]; then
          echo "== sleep: login1 did not start; refusing a client that cannot resume"
          exit 69
        fi
        echo "== sleep: login1 ready, Android session pause/resume available"
      else
        echo "== network: the system bus did not come up; the client will show no connection"
        exit 69
      fi
    else
      echo "== network: no dbus-daemon or netmanager in this runtime; the client will show no connection"
      exit 69
    fi

    export STEAM_RUNTIME=1
    export LD_LIBRARY_PATH=$steam_root/steamrtarm64:$steam_root/steamrtarm64/panorama${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export SDL_VIDEO_X11_DGAMOUSE=0
    # Decky is optional and session scoped: the app's marker opts in, and this supervisor is
    # reaped with the client session. Native ARM64 runs directly. A legacy x86_64 asset is used
    # only when its recorded architecture says so and droiddeck-fex has FEX and its runtime ready.
    decky_loader=$HOME/homebrew/services/PluginLoader
    if [ -f "$HOME/.droiddeck-decky-enabled" ] && [ -x "$decky_loader" ]; then
      decky_arch=$(cat "$HOME/homebrew/services/.droiddeck-decky-arch" 2>/dev/null || echo unknown)
      if [ "$decky_arch" = arm64 ] || { [ "$decky_arch" = x86_64 ] && /usr/local/bin/droiddeck-fex prepare >/dev/null; }; then
        (
          decky_child=
          decky_stop() { [ -z "$decky_child" ] || kill "$decky_child" 2>/dev/null; [ -z "$decky_child" ] || wait "$decky_child" 2>/dev/null; exit 0; }
          trap decky_stop TERM INT HUP
          decky_exits=0
          while :; do
            if [ "$decky_arch" = x86_64 ]; then /usr/local/bin/droiddeck-fex run --mode on -- "$decky_loader" >>"$HOME/homebrew/services/PluginLoader.log" 2>&1 &
            else "$decky_loader" >>"$HOME/homebrew/services/PluginLoader.log" 2>&1 &
            fi
            decky_child=$!
            decky_status=0
            wait "$decky_child" || decky_status=$?
            decky_child=
            decky_exits=$((decky_exits + 1))
            if [ "$decky_exits" -ge 5 ]; then
              echo "== Decky: stopped after $decky_exits loader exits (last status $decky_status)"
              break
            fi
            decky_delay=$((decky_exits * 3))
            echo "== Decky: loader exited with status $decky_status; restart $((decky_exits + 1))/5 in ${decky_delay}s"
            sleep "$decky_delay"
          done
        ) &
        decky_supervisor=$!
        echo "== Decky: session supervisor started ($decky_arch)"
      else
        echo "== Decky: installed loader architecture is unsupported by this guest; not starting"
      fi
    fi
    _bl_cdp=()
    if [ -f "$steam_root/.cef-enable-remote-debugging" ]; then
      export BL_CDP_PORT=8080
    else
      export BL_CDP_PORT=$((20000 + RANDOM % 30000))
      _bl_cdp=(-cef-enable-debugging -devtools-port "$BL_CDP_PORT")
    fi
    if [ -f "$HOME/.droiddeck-decky-enabled" ] && [ "${decky_arch:-}" = x86_64 ]; then
      echo "== steam: devtools port $BL_CDP_PORT left open for the x86_64 Decky loader"
    else
      export BL_CDP_GUARD=$BL_CDP_PORT
      echo "== steam: devtools port $BL_CDP_PORT, guest processes only"
    fi
    # The agent bridge drives the client through it (droiddeck-agent's cdp requests).
    [ -n "${BL_LAUNCH_DIR:-}" ] && mkdir -p "$BL_LAUNCH_DIR/agent" && echo "$BL_CDP_PORT" > "$BL_LAUNCH_DIR/agent/cdp-port"
    droiddeck-steam-compat "$steam_root" 2>&1 &
    # The client exits 42 when it has updated itself and wants a fresh start (steam.sh does this).
    # BL_STEAM_UI=desktop = the client's desktop UI (a window, the library as a list), which the
    # desktop's launchers ask for; gamescope shows one window at a time and the game takes over.
    _bl_ui=(-gamepadui)
    [ "${BL_STEAM_UI:-}" = desktop ] && _bl_ui=()
    # Deck mode (BL_STEAMDECK=1, the Steam page's Client settings): -steamdeck is the flag that puts
    # the Quick Access Menu and the Deck settings pages on screen; the QAM's performance overlay
    # controls stay greyed out without -steamos3, as SteamOS and Armada launch it. -steamos3 makes
    # the client manage itself as SteamOS does - it calls steamos-select-branch and writes
    # steamdeck_stable to package/beta, and a branch on disk that loses to the -clientbeta below
    # is an update that never installs: exit 42, a restart, for ever (Bannerlator 38996ea1). The
    # loop below puts package/beta back before every start. The SteamOS helpers the client calls
    # in this mode are staged as no-op stubs under /usr/bin.
    if [ "${BL_STEAMDECK:-0}" = 1 ] && [ "${BL_STEAM_UI:-}" != desktop ]; then
      _bl_ui+=(-steamdeck -steamos3)
      # The QAM's Scaling Filter lists NVIDIA Image Scaling only when told gamescope has it (it does).
      export STEAM_GAMESCOPE_NIS_SUPPORTED=1
      # And shows its Scaling Mode and Scaling Filter only when told gamescope takes them.
      export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
      echo "== steam: Deck mode on (-steamdeck -steamos3)"
    fi
    # The power menu's Shut Down and Restart. Without these the client blanks its interface and
    # stays up (device, 2026-10-12: System.ShutdownPC and nothing after it). With them it does what
    # SteamOS's gamescope session expects: writes the sentinel and exits. The loop below ends the
    # session for one and starts the client again for the other.
    export STEAMOS_STEAM_SHUTDOWN_SENTINEL="$HOME/.bl-steam-shutdown"
    export STEAMOS_STEAM_REBOOT_SENTINEL="$HOME/.bl-steam-reboot"
    # What a killed session leaves behind. Android ends sessions without warning (backgrounding, the
    # low-memory killer), and the client then finds .crash - opening its update UI on the spinner -
    # and the web helper's Singleton* locks in htmlcache, owned by a process that is gone, which can
    # leave the Gamepad UI blank. No client or helper is running at this point in a session.
    if ! pgrep -f 'steamwebhelper|steamrtarm64/steam' >/dev/null 2>&1; then
      _stale=""
      for _f in "$steam_root/.crash" "$steam_root/steam.pid" \
                "$steam_root/config/htmlcache/SingletonLock" "$steam_root/config/htmlcache/SingletonCookie" \
                "$steam_root/config/htmlcache/SingletonSocket"; do
        if [ -e "$_f" ] || [ -L "$_f" ]; then rm -f "$_f" && _stale="$_stale ${_f##*/}"; fi
      done
      [ -n "$_stale" ] && echo "== steam: cleared what an earlier session left:$_stale"
      unset _stale _f
    fi
    # Use the same configured branch as the first-run download. Whatever wrote package/beta, the branch on
    # disk has to agree with the one forced here - a disagreement is the restart loop above, and
    # it is silent apart from rc=42 in this log.
    # Checked before every start, not once: the client rewrites package/beta during its own run,
    # and a restart below (rc=42, or the one after the ARM64 Proton lands) would otherwise start it
    # again on the branch it just wrote.
    steam_channel=${BL_STEAM_CHANNEL:-steamdeck_publicbeta}
    # The app's language (Setup, or the system's): the client's interface takes -language over its
    # registry, and the registry is rewritten before each start below for its update window.
    _bl_lang=()
    [ -n "${BL_STEAM_LANGUAGE:-}" ] && _bl_lang=(-language "$BL_STEAM_LANGUAGE")
    steam_beta=$steam_root/package/beta
    if [ -n "${BL_ADDED_GAMES:-}" ] && [ -f "$BL_ADDED_GAMES" ]; then
      droiddeck-steam-games watch "$steam_root" "$BL_ADDED_GAMES" &
      games_watcher=$!
    fi
    # Lossless Scaling (Steam app 993090): whether this account owns it, asked of the signed-in
    # client once a session until the answer is yes. From then on the app offers importing
    # Lossless.dll and passes BL_LOSSLESS_OWNED=1, so the question is never asked again.
    if [ "${BL_LOSSLESS_OWNED:-0}" != 1 ]; then
      (
        owned=$HOME/.config/droiddeck/lossless-owned
        for ((_i = 0; _i < 60; _i++)); do
          nap 30
          [ -e "$owned" ] && exit 0
          answer=$(droiddeck-steam-games probe "$steam_root" 993090 2>/dev/null) || continue
          case $answer in
            *'"993090": true'*) mkdir -p "${owned%/*}" && : > "$owned" && echo "== Lossless Scaling: owned" ;;
            *) echo "== Lossless Scaling: not owned by this account" ;;
          esac
          exit 0
        done
      ) &
    fi
    # The client's browser (CEF) is kept off the GPU: on a Mali-G615 the session came all the way
    # up - gamescope compositing on the real GPU, both Xwaylands answering, the client past its own
    # checks - and the device restarted seconds after the browser asked that GPU for Vulkan (RC2 on
    # a G720-class phone, then again on RC3 + dma-buf WSI on a G615 POCO X6 Pro with 1f4abb3; the
    # store had already opened, so the WSI was fine and the fault is in CEF's own ANGLE-Vulkan
    # path). That restart is a device reset no app can survive, so on Mali the GPU browser is not
    # offered at all: BL_CEF_GPU=1 is answered with a line and the CPU-drawn client, which since
    # the R5 dma-buf WSI is no longer the slow path it was. Non-Mali keeps the old behavior.
    _bl_cef=(-no-cef-sandbox -cef-ozone-platform=x11)
    # Anything the session wants to add to the client itself, one word list, never evaluated:
    # BL_STEAM_ARGS="-cef-single-process" runs the whole browser in one process, which is the
    # largest cut available in the client's own memory - and the one most likely to make the store
    # come back blank instead, which is why it is not on by default.
    _bl_extra_args=()
    if [ -n "${BL_STEAM_ARGS:-}" ]; then
      read -r -a _bl_extra_args <<<"$BL_STEAM_ARGS"
    fi
    if [ "$software" != yes ] && [ "${BL_CEF_GPU:-0}" = 1 ] && [ "${BL_GPU_FAMILY:-}" != mali ]; then
      _bl_cef+=(-cef-use-gl=angle -cef-use-angle=vulkan -cef-force-gpu)
    else
      if [ "${BL_CEF_GPU:-0}" = 1 ] && [ "${BL_GPU_FAMILY:-}" = mali ] && [ "$software" != yes ]; then
        echo "== ui-on-gpu: not on Mali - ANGLE/Vulkan restarted the device (RC2 and RC3); the dma-buf WSI already carries the client at speed"
      fi
      _bl_cef+=(-cef-disable-gpu -cef-disable-gpu-compositing)
    fi
    echo "== steam args: ${_bl_ui[*]} ${_bl_cdp[*]} ${_bl_lang[*]} -clientbeta $steam_channel ${_bl_cef[*]} ${_bl_extra_args[*]:-} $*"
    # The one thing a session that dies under a game cannot say for itself, and the one thing every
    # report has needed: whether it ran out of memory or out of CPU. Two reads of /proc every ten
    # seconds, printed beside everything else, so the last line before a death is the state that
    # killed it - a load above the core count and a few hundred MB left say different things.
    # Available on its own did not settle it: two sessions fell from 2.3 GB to 0.4 GB in under three
    # minutes and died there, which says the memory went somewhere and not what took it. So it now
    # says apart what is in anonymous pages - a process, or a driver holding it, which is not given
    # back - from what is cache, which is; and names the three largest processes by resident set.
    (
      # How much of the cpu was busy over the last ten seconds, counted from /proc/stat rather than
      # read off the load average: every one of these sessions has reported load 0.00 while frames
      # stopped and memory went, and 0.00 says either nothing is running or the number is not the
      # host's. This one is arithmetic on the host's own counters, so it cannot be quietly wrong -
      # and it is the difference between a device that is too slow and one that is waiting on the
      # gpu, which are fixed in opposite directions.
      _bl_stat() { awk '/^cpu /{ idle = $5 + $6; tot = $2 + $3 + $4 + $5 + $6 + $7 + $8; print tot " " idle }' /proc/stat 2>/dev/null; }
      _bl_cpu0=$(_bl_stat)
      for ((_i = 0; _i < 720; _i++)); do
        nap 10
        _bl_load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null) || continue
        _bl_cpu1=$(_bl_stat)
        _bl_busy=$(awk -v a="${_bl_cpu0:-0 0}" -v b="${_bl_cpu1:-0 0}" 'BEGIN { split(a, p); split(b, n); dt = n[1] - p[1]; di = n[2] - p[2]; printf "cpu %d%%", (dt > 0) ? (dt - di) * 100 / dt : 0 }')
        _bl_cpu0=$_bl_cpu1
        _bl_mem=$(awk '/^MemAvailable:/ { a = $2 } /^AnonPages:/ { n = $2 } /^Cached:/ { c = $2 } END { printf "available %d MB · anon %d MB · cached %d MB", a / 1024, n / 1024, c / 1024 }' /proc/meminfo 2>/dev/null)
        _bl_top=$(ps -eo rss=,pid=,comm= --sort=-rss 2>/dev/null | head -3 | awk '{ printf "%d MB %s [%s] · ", $1 / 1024, $3, $2 }')
        _bl_top=${_bl_top% · }
        # The client's browser, on its own: the store, the library and the chat are one CEF renderer
        # each, and together they are the largest thing a session carries that is not the game. Named
        # apart from the top three, so a number that climbs is visible as it climbs rather than being
        # inferred from a bare "available" that has already fallen.
        _bl_web=$(ps -eo rss=,comm= 2>/dev/null | awk '$2 ~ /steamwebhelper/ { n++; s += $1 } END { printf "%d MB en %d", s / 1024, n }')
        echo "== heartbeat $(date +%T): ${_bl_busy:-cpu ?} · load ${_bl_load// /,} · ${_bl_mem:-available ?} · tienda ${_bl_web:-?} · top: ${_bl_top:-?}"
        # Descriptors, not memory, ended the build 40 session (above). Which process spends
        # them is the one thing that log could not say, so count them: every third beat is
        # often enough for a leak this slow and keeps the cost of listing them off the CPU
        # a game is using. At 80% of the ceiling the session is minutes from dying - say so
        # while there is still a log to read it from.
        if [ $(( _i % 3 )) -eq 0 ]; then
          _bl_fd_soft=$(ulimit -Sn 2>/dev/null) || _bl_fd_soft=0
          _bl_fd_worst=0
          _bl_fd_who=
          for _p in $(ps -eo pid= 2>/dev/null); do
            [ -d "/proc/$_p/fd" ] || continue
            _bl_n=$(ls -f "/proc/$_p/fd" 2>/dev/null | wc -l) || continue
            if [ "${_bl_n:-0}" -gt "$_bl_fd_worst" ]; then
              _bl_fd_worst=$_bl_n
              _bl_fd_who="$(cat "/proc/$_p/comm" 2>/dev/null) [$_p]"
            fi
          done
          echo "== fds: $_bl_fd_worst of ${_bl_fd_soft:-?} · worst: ${_bl_fd_who:-?}"
          if [ "${_bl_fd_soft:-0}" -gt 0 ] &&
             [ $(( _bl_fd_worst * 100 / _bl_fd_soft )) -ge 80 ]; then
            echo "== fd warning: ${_bl_fd_who:-?} holds $_bl_fd_worst of $_bl_fd_soft descriptors; at the ceiling nothing in this session can allocate GPU memory"
          fi
        fi
        # Below BL_MEM_LOG_MB the three largest are no longer enough to say anything: sessions have
        # been lost with 900 MB free, three processes named, and none of them the one that took it.
        # So from there down every beat names eight, with their arguments, which is what tells a
        # game's own resident set apart from the browser's, FEX's and the shader compilers'.
        _bl_free=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo 2>/dev/null)
        if [ -n "$_bl_free" ] && [ "$_bl_free" -lt $(( ${BL_MEM_LOG_MB:-1024} * 1024 )) ]; then
          _bl_who=$(ps -eo rss=,pid=,args= --sort=-rss 2>/dev/null | head -8 |
            awk '{ cmd = substr($0, index($0, $3), 44); printf "%d MB [%s] %s · ", $1 / 1024, $2, cmd }')
          echo "== memory low ($(( _bl_free / 1024 )) MB): ${_bl_who% · }"
        fi
        # The R7 killer named: Clicker Heroes grew to 3.1 GB resident and Android's low-memory
        # killer took the whole session - no crash, no error, just gone. When a game itself holds
        # more than 2.5 GB, say so while it is still alive, so "it closed" arrives with the reason.
        _bl_game_rss=$(ps -eo rss=,args= --sort=-rss 2>/dev/null | awk '$2 ~ /steamapps/ && $0 ~ /steamapps.common/ { print $1; exit }')
        if [ -n "${_bl_game_rss:-}" ] && [ "$_bl_game_rss" -gt 2560000 ]; then
          echo "== game memory: the game holds $(( _bl_game_rss / 1024 )) MB resident - near what Android tolerates on this device; close background apps and expect a kill above this"
        fi
        # A game running, read off /proc rather than guessed: the client launches one with the
        # game's own path (Linux slashes or Wine backslashes) or reaper's SteamLaunch AppId= in
        # its command line, and nothing else in the session carries it.
        _bl_game=0
        for _d in /proc/[0-9]*; do
          _c=$(tr '\0' ' ' < "$_d/cmdline" 2>/dev/null) || continue
          case $_c in *steamapps/common*|*steamapps\\common*|*"SteamLaunch AppId="*) _bl_game=1; break ;; esac
        done
        # Pick the largest replaceable CEF --type=renderer process (never the main steamwebhelper
        # browser, --type=gpu-process, --type=zygote, or --type=utility: killing gpu-process 3
        # times triggers CEF's gpu:3 full browser shutdown and restarts the Steam UI).
        _bl_largest_renderer() {
          local _p _a _rss _best_pid= _best_rss=0 _count=0
          for _d in /proc/[0-9]*; do
            _p=${_d#/proc/}
            _a=$(tr '\0' ' ' < "$_d/cmdline" 2>/dev/null) || continue
            case $_a in *steamwebhelper*--type=renderer*) ;; *) continue ;; esac
            _count=$(( _count + 1 ))
            _rss=$(awk '/^VmRSS:/ { printf "%d", $2 }' "$_d/status" 2>/dev/null) || continue
            if [ "${_rss:-0}" -gt "$_best_rss" ]; then
              _best_rss=$_rss
              _best_pid=$_p
            fi
          done
          [ "$_count" -gt "${BL_WEB_MIN:-3}" ] && [ -n "$_best_pid" ] && printf '%s' "$_best_pid"
        }
        # Optional browser renderer budget (off by default now that steamwebhelper is isolated
        # from panvk/ANGLE; set BL_WEB_MB to enable).
        _bl_web_cap=${BL_WEB_MB:-0}
        [ "$_bl_game" = 1 ] && [ "${BL_WEB_MB:-0}" -gt 0 ] 2>/dev/null && _bl_web_cap=${BL_WEB_GAME_MB:-350}
        if [ "$_bl_web_cap" -gt 0 ] 2>/dev/null; then
          _bl_web_mb=$(ps -eo rss=,comm= 2>/dev/null |
            awk '$2 ~ /steamwebhelper/ { n++; s += $1 } END { printf "%d %d", s / 1024, n }')
          if [ "${_bl_web_mb%% *}" -gt "$_bl_web_cap" ] 2>/dev/null; then
            _bl_now=$(date +%s)
            if [ $(( _bl_now - ${_bl_web_at:-0} )) -ge "${BL_WEB_SECS:-30}" ]; then
              _bl_fat=$(_bl_largest_renderer)
              if [ -n "$_bl_fat" ]; then
                _bl_web_at=$_bl_now
                echo "== web trim: the client's browser is ${_bl_web_mb%% *} MB in ${_bl_web_mb##* } processes, over its $_bl_web_cap MB budget - dropping renderer [$_bl_fat]"
                kill "$_bl_fat" 2>/dev/null || :
              fi
            fi
          fi
        fi
        # Wine servers the client's own probes leave behind. On the way in the client runs Proton
        # in the shared prefix to ask the machine what it is, and those runs leave a wineserver
        # with an explorer.exe drawing a desktop nobody ever sees: 197 MB each, two of them, held
        # for the whole session in build 41's log. No game runs in that prefix - a real launch
        # gets one of its own - so with memory this tight they are the safest thing here to take
        # back. BL_WINE_SWEEP_MB=0 turns it off.
        if [ "${_bl_free:-0}" -lt $(( ${BL_WINE_SWEEP_MB:-1500} * 1024 )) ] &&
           [ "${BL_WINE_SWEEP_MB:-1500}" -gt 0 ] 2>/dev/null; then
          _bl_now=$(date +%s)
          if [ $(( _bl_now - ${_bl_sweep_at:-0} )) -ge "${BL_MEM_VALVE_SECS:-30}" ]; then
            for _pat in '(explorer|services|winedevice|plugplay)\.exe' '^wineserver$'; do
              for _d in /proc/[0-9]*; do
                _p=${_d#/proc/}
                _bl_c=$(cat "$_d/comm" 2>/dev/null) || continue
                _bl_a=$(tr '\0' ' ' < "$_d/cmdline" 2>/dev/null) || _bl_a=
                [[ $_bl_c =~ $_pat || $_bl_a =~ $_pat ]] || continue
                tr '\0' '\n' < "$_d/environ" 2>/dev/null |
                  grep -q '^WINEPREFIX=.*/compatdata/0/*$' || continue
                _bl_rss=$(awk '/^VmRSS:/ { printf "%d", $2 / 1024 }' "$_d/status" 2>/dev/null)
                if kill "$_p" 2>/dev/null; then
                  _bl_sweep_at=$_bl_now
                  echo "== wine sweep: $_bl_c [$_p] ${_bl_rss:-?} MB - a server the client's own probes left in the shared prefix"
                fi
              done
            done
          fi
        fi
        # BL_MEM_VALVE_MB (off unless set): with the device this close to killing the session, drop
        # the largest extra browser renderer. Only ever a replaceable --type=renderer: never the
        # main browser, never --type=gpu-process, never the client, never the game.
        if [ -n "${BL_MEM_VALVE_MB:-}" ] && [ -n "$_bl_free" ] && [ "$_bl_free" -lt $(( BL_MEM_VALVE_MB * 1024 )) ]; then
          _bl_now=$(date +%s)
          if [ $(( _bl_now - ${_bl_valve_at:-0} )) -ge "${BL_MEM_VALVE_SECS:-30}" ]; then
            _bl_fat=$(_bl_largest_renderer)
            if [ -n "$_bl_fat" ]; then
              _bl_valve_at=$_bl_now
              echo "== memory valve: ${BL_MEM_VALVE_MB} MB left, dropping browser renderer [$_bl_fat]"
              kill "$_bl_fat" 2>/dev/null || true
            fi
          fi
        fi
      done
    ) &
    # An update that cannot install asks for a restart (rc=42) every time; the count is capped so a
    # session can never again loop in silence, which reads as a menu opening and closing by itself.
    steam_updates=0
    rm -f "$HOME/.bl-stop-requested" "$STEAMOS_STEAM_SHUTDOWN_SENTINEL" "$STEAMOS_STEAM_REBOOT_SENTINEL"
    if [ -n "${BL_LAUNCH_DIR:-}" ] && [ -d "$BL_LAUNCH_DIR" ]; then
      rm -f "$BL_LAUNCH_DIR/steam-stop" "$BL_LAUNCH_DIR/steam-game" "$BL_LAUNCH_DIR/steam-game.tmp"
      (
        while :; do
          if [ -e "$BL_LAUNCH_DIR/steam-stop" ]; then
            rm -f "$BL_LAUNCH_DIR/steam-stop"
            : > "$HOME/.bl-stop-requested"
            echo "== steam: the app asked for a clean exit"
            "$steam_root/steamrtarm64/steam" -shutdown >/dev/null 2>&1 || true
            exit 0
          fi
          if [ -f "$BL_LAUNCH_DIR/steam-game" ]; then
            game_id=$(cat "$BL_LAUNCH_DIR/steam-game" 2>/dev/null)
            rm -f "$BL_LAUNCH_DIR/steam-game"
            case $game_id in
              ''|0*|*[!0-9]*) echo "== steam: ignored invalid game launch request" ;;
              *)
                game_id_length=${#game_id}
                if [ "$game_id_length" -lt 20 ] || {
                  [ "$game_id_length" -eq 20 ] && [[ "$game_id" < "18446744073709551616" ]];
                }; then
                  echo "== steam: launching requested game $game_id in the running client"
                  "$steam_root/steamrtarm64/steam" "steam://rungameid/$game_id" >/dev/null 2>&1 &
                else
                  echo "== steam: ignored out-of-range game launch request"
                fi
                ;;
            esac
          fi
          nap 0.5
        done
      ) &
      stop_watcher=$!
    fi
    while :; do
      rm -f "$HOME/.bl-restart-once"
      if [ -f "$steam_beta" ] && [ "$(cat "$steam_beta" 2>/dev/null)" != "$steam_channel" ]; then
        echo "== steam: client branch on disk was '$(cat "$steam_beta" 2>/dev/null)', set to '$steam_channel' to match -clientbeta"
        echo "$steam_channel" > "$steam_beta"
      fi
      if [ -z "${_bl_counted:-}" ] && [ -z "${BL_DESKTOP:-}" ]; then
        echo start >> "$steam_root/package/droiddeck-unconfirmed"
        _bl_counted=1
      fi
      # Between starts only: the client holds registry.vdf in memory and writes it back on exit.
      if [ -n "${BL_STEAM_LANGUAGE:-}" ]; then
        droiddeck-steam-language "$HOME" "$BL_STEAM_LANGUAGE" || true
      fi
      step "starting the Steam client${BL_STEAM_UI:+ ($BL_STEAM_UI UI)}"
      "$steam_root/steamrtarm64/steam" "${_bl_ui[@]}" "${_bl_cdp[@]}" "${_bl_lang[@]}" -clientbeta "$steam_channel" \
        "${_bl_cef[@]}" ${_bl_extra_args[@]+"${_bl_extra_args[@]}"} "$@"
      rc=$?
      echo "== steam exited rc=$rc"
      if [ -n "${BL_ADDED_GAMES:-}" ] && [ -f "$BL_ADDED_GAMES" ]; then
        droiddeck-steam-shortcuts "$steam_root" "$BL_ADDED_GAMES" || true
      fi
      collect_steam_logs
      if [ -f "$HOME/.config/droiddeck/fex-wanted" ] && [ -x /usr/local/bin/droiddeck-fex ]; then
        /usr/local/bin/droiddeck-fex status >/dev/null 2>&1 || true
      fi
      if [ -f "$HOME/.bl-stop-requested" ]; then
        rm -f "$HOME/.bl-stop-requested" "$HOME/.bl-restart-once"
        break
      fi
      if [ -e "$STEAMOS_STEAM_SHUTDOWN_SENTINEL" ]; then
        rm -f "$STEAMOS_STEAM_SHUTDOWN_SENTINEL" "$HOME/.bl-steam-reboot"
        echo "== steam: Shut Down from the power menu; ending the session"
        rc=0
        break
      fi
      if [ -e "$STEAMOS_STEAM_REBOOT_SENTINEL" ]; then
        rm -f "$STEAMOS_STEAM_REBOOT_SENTINEL"
        echo "== steam: Restart from the power menu; starting the client again"
        set --
        continue
      fi
      # The session asked for this exit (the ARM64 Proton landed): start again, without the URL
      # arguments, which were acted on. Not counted against the update cap.
      if [ -f "$HOME/.bl-restart-once" ]; then
        echo "== steam: restarting once so the new compatibility layer is in the client's lists"
        set --
        continue
      fi
      [ "$rc" -eq 42 ] || break
      steam_updates=$((steam_updates + 1))
      if [ "$steam_updates" -ge 3 ]; then
        echo "== steam: asked to restart for an update $steam_updates times and it is not installing; the session stops here rather than loop"
        break
      fi
      # The URL arguments were acted on the first time; a restart must not repeat them.
      set --
    done
    if [ -n "${stop_watcher:-}" ]; then
      kill "$stop_watcher" 2>/dev/null || true
      wait "$stop_watcher" 2>/dev/null || true
    fi
    if [ -n "${games_watcher:-}" ]; then
      kill "$games_watcher" 2>/dev/null || true
      wait "$games_watcher" 2>/dev/null || true
    fi
    if [ -n "${BL_DESKTOP:-}" ]; then
      # Started from the desktop (droiddeck-steam-launch): the desktop's own programs share this
      # script's parent, so reap_orphans - right under gamescope, where everything is the client's -
      # is not for here. The helpers this run started (the cores and redistributables beats, the
      # system bus and the NetworkManager stand-in) go with the client instead.
      if [ -n "${decky_supervisor:-}" ]; then
        kill "$decky_supervisor" 2>/dev/null || true
        wait "$decky_supervisor" 2>/dev/null || true
        echo "== Decky: session supervisor stopped"
      fi
      _bl_jobs=$(jobs -p)
      [ -n "$_bl_jobs" ] && kill $_bl_jobs 2>/dev/null
      echo "== steam: the client on the desktop has exited"
    else
      if [ -n "${decky_supervisor:-}" ]; then
        kill "$decky_supervisor" 2>/dev/null || true
        wait "$decky_supervisor" 2>/dev/null || true
        echo "== Decky: session supervisor stopped"
      fi
      _bl_jobs=$(jobs -p)
      [ -n "$_bl_jobs" ] && kill $_bl_jobs 2>/dev/null
      reap_orphans
    fi
    exit "$rc"
    ;;
  *)
    echo "droiddeck-session: unknown mode '$mode'" >&2
    exit 64
    ;;
esac
