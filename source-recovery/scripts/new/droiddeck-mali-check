#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
# Read-only checks INSIDE DroidDeck's own Linux guest/app UID. No su/chmod/SELinux changes.
set -u
icd=${BL_VK_DRIVER:-${VK_DRIVER_FILES:-}}
if [ -z "$icd" ] || [ ! -r "$icd" ]; then
    echo "DD_MALI_CHECK_FAILED: no readable selected ICD manifest"
    exit 78
fi
if [ ! -c /dev/mali0 ]; then
    echo "DD_MALI_CHECK_FAILED: /dev/mali0 is absent or is not a character device in the guest"
    exit 78
fi
if ! python3 - "$icd" <<'PY'
import ctypes, json, os, pathlib, sys
try:
    manifest = pathlib.Path(sys.argv[1])
    icd = json.loads(manifest.read_text())['ICD']
    library = pathlib.Path(icd['library_path'])
    if not library.is_absolute(): library = manifest.parent / library
    with library.open('rb') as f: header = f.read(20)
    if not (header[:4] == b'\x7fELF' and header[4:6] == b'\x02\x01' and int.from_bytes(header[18:20], 'little') == 183):
        raise RuntimeError('selected library is not ELF64 little-endian AArch64')
    driver = ctypes.CDLL(str(library), mode=os.RTLD_NOW | os.RTLD_LOCAL)
    negotiate = driver.vk_icdNegotiateLoaderICDInterfaceVersion
    negotiate.argtypes = [ctypes.POINTER(ctypes.c_uint32)]
    negotiate.restype = ctypes.c_int32
    version = ctypes.c_uint32(7)
    result = negotiate(ctypes.byref(version))
    if result != 0: raise RuntimeError('ICD negotiation failed: '+str(result)+'; check backend/dependencies above')
    gipa = driver.vk_icdGetInstanceProcAddr
    gipa.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
    gipa.restype = ctypes.c_void_p
    if not gipa(None, b'vkCreateInstance'): raise RuntimeError('ICD has no vkCreateInstance entry point')
    print('DD_MALI_ICD_LOAD_OK: interface '+str(version.value)+'; '+str(library))
    print('DD_MALI_NOTE: loading an ICD is not proof of GPU rendering or Steam compatibility')
except Exception as error:
    print('DD_MALI_CHECK_FAILED: '+str(error), file=sys.stderr)
    sys.exit(78)
PY
then
    exit 78
fi
if command -v vulkaninfo >/dev/null 2>&1; then
    if command -v timeout >/dev/null 2>&1; then
        output=$(VK_LOADER_DEBUG=error timeout 20s vulkaninfo --summary 2>&1); result=$?
    else
        echo "DD_MALI_PROBE_SKIPPED: timeout is not installed; not running an unbounded GPU probe"
        exit 0
    fi
    printf '%s\n' "$output"
    if [ "$result" != 0 ]; then
        echo "DD_MALI_VULKAN_PROBE_FAILED: exit $result; do not interpret library-load success as hardware support"
        exit 78
    fi
    # The driver names CSF GPUs with their core count since beta.18: "Mali-G615 MC6",
    # "Mali-G925-Immortalis MC12", "Mali-G57 MC2". The kit was validated on the G615, but
    # PanVK-kbase ships one universal ICD for v9-v13, and other Malis enumerate through the
    # same driver - refusing every name but G615 left those phones (an Immortalis-G925 Turbo
    # 5 Max, a G720, a G715) a session that died here, before gamescope ever ran.
    reported=$(printf '%s\n' "$output" | grep -Eo '(Mali|Immortalis)-G[0-9]+' | head -1)
    if [ -z "$reported" ]; then
        echo "DD_MALI_WRONG_GPU: the selected driver reported no ARM Mali GPU; refusing to start"
        exit 78
    fi
    if [ "$reported" = Mali-G615 ]; then
        echo "DD_MALI_GPU_REPORTED: Mali-G615 (the validated device); gamescope/Steam presentation still needs on-device validation"
    else
        echo "DD_MALI_GPU_REPORTED: $reported (not the Mali-G615 this kit was validated on; PanVK-kbase supports v9-v13, but Steam on this GPU is untested)"
    fi
else
    echo "DD_MALI_PROBE_SKIPPED: vulkaninfo is not installed; GPU enumeration has not been validated"
fi
