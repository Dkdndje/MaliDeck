 bl_libpath() {
+  # Steam's post-logon CGetCompatToolBucketJob runs d3ddriverquery64.exe six times at once across
+  # every registered Proton on compatdata/0, and shader_log.txt ends every one of them with
+  # 'Unknown shader cache type, ignoring.' Meanwhile those concurrent Protons fight over
+  # compatdata/0, hang for a minute, and leave orphan explorer.exe + mesa zink processes holding
+  # ~400 MB before a game is even opened. Short-circuit the probe unless BL_RUN_PROBES=1 asks for it.
+  case "${verb:-}:$*" in
+    waitforexitandrun:*) ;;
+    *:*d3ddriverquery*.exe*) [ "${BL_RUN_PROBES:-0}" = 1 ] || exit 0 ;;
+  esac
+  case "${STEAM_COMPAT_DATA_PATH:-}" in
+    */compatdata/0|*/compatdata/0/|*/compatdata/0-*) export PROTONFIXES_DISABLE=1 ;;
+  esac
+  # FSR4's amdxcffx64.dll is an x86_64 AMD upscaler that does not exist in ARM64 Proton trees;
+  # ProtonFixes otherwise tries to validate and download it on every launch.
+  export PROTON_FSR4_UPGRADE=${PROTON_FSR4_UPGRADE:-0}
+  # Skip Wine's post-Vulkan OpenGL GPU probe in win32u (sysparams.c:3183) so explorer.exe does not
+  # load Mesa's zink + panvk (~290 MB of /dev/mali0 prerast/heap mappings) just to read GL strings.
+  export WINE_SKIP_OPENGL_GPU_PROBE=${WINE_SKIP_OPENGL_GPU_PROBE:-1}
+  # On Android, nsiproxy.sys's netlink bind is denied with errno 13, leaving GetAdaptersAddresses /
+  # GetBestRoute blocked when Unity or Steam games probe the network at startup.
+  case ";${WINEDLLOVERRIDES:-};" in
+    *";nsiproxy.sys="* ) ;;
+    * ) export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}nsiproxy.sys=d" ;;
+  esac
+  # Disable Steam's Fossilize layer inside games and enable PanVK's persistent disk shader cache so
+  # compiled Mali ISA shaders survive across VkDevice instances and sessions.
+  unset ENABLE_VK_LAYER_VALVE_steam_fossilize_1
+  export DISABLE_VK_LAYER_VALVE_steam_fossilize_1=1
+  mkdir -p "${HOME:-/root}/.cache/mesa_shader_cache" 2>/dev/null || true
+  export MESA_SHADER_CACHE_DIR="${MESA_SHADER_CACHE_DIR:-${HOME:-/root}/.cache/mesa_shader_cache}"
+  export MESA_SHADER_CACHE_DISABLE="${MESA_SHADER_CACHE_DISABLE:-false}"
+  export MESA_SHADER_CACHE_MAX_SIZE="${MESA_SHADER_CACHE_MAX_SIZE:-512M}"
+  # Clamp PanVK-kbase's reported Vulkan heap size (panvk_physical_device.c:528) to 12% of RAM
+  # (~878 MiB on an 8 GB device, < 7 * 128 MiB = 896 MiB), which shrinks DXVK's devicePool
+  # maxChunkSize (determineMaxChunkSize) from 256 MiB down to 64 MiB (4x smaller /dev/mali0 chunks).
+  export heap_memory_percent=${heap_memory_percent:-0.12}
+  # Trim FEX's translation caches and silence its debug log across every Proton (Valve, GE, CachyOS)
+  # even if the saved preset is COMPATIBILITY; per-game environment entries applied by
+  # droiddeck-game-env afterwards still win when set explicitly.
+  export FEX_DISABLEL2CACHE=${FEX_DISABLEL2CACHE:-1}
+  export FEX_DYNAMICL1CACHE=${FEX_DYNAMICL1CACHE:-1}
+  export FEX_DYNAMICL1CACHEINCREASECOUNTHEURISTIC=${FEX_DYNAMICL1CACHEINCREASECOUNTHEURISTIC:-250}
+  export FEX_DYNAMICL1CACHEDECREASECOUNTHEURISTIC=${FEX_DYNAMICL1CACHEDECREASECOUNTHEURISTIC:-50}
+  export FEX_SILENTLOG=${FEX_SILENTLOG:-1}
+  export WINEVMEMMAXSIZE=${WINEVMEMMAXSIZE:-4096}
+  # Proton and DXVK logs for real game launches only (waitforexitandrun), shared by both
+  # droiddeck-proton and droiddeck-proton-wrap (GE-Proton, CachyOS, DroidDeck-Proton).
+  if [ "${verb:-}" = waitforexitandrun ]; then
+    case ${BL_PROTON_LOG:-1} in
+      0) ;;
+      verbose)
+        if [ -n "${BL_DEBUG_DIR:-}" ]; then
+          mkdir -p "$BL_DEBUG_DIR/steam" 2>/dev/null
+          export PROTON_LOG=1 PROTON_LOG_DIR="$BL_DEBUG_DIR/steam"
+          export WINEDEBUG="${WINEDEBUG:-+timestamp,+pid,+tid,+seh,+err,+warn,+loaddll}"
+        fi
+        ;;
+      *)
+        if [ -n "${BL_DEBUG_DIR:-}" ]; then
+          mkdir -p "$BL_DEBUG_DIR/steam" 2>/dev/null
+          export PROTON_LOG=1 PROTON_LOG_DIR="$BL_DEBUG_DIR/steam"
+          export WINEDEBUG="${WINEDEBUG:-+timestamp,+pid,+tid,+err}"
+        fi
