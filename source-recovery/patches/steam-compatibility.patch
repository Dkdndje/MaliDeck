+    esac
+    case ${BL_DXVK_LOG:-1} in
+      0) ;;
+      *)
+        if [ -n "${BL_DEBUG_DIR:-}" ]; then
+          mkdir -p "$BL_DEBUG_DIR/steam" 2>/dev/null
+          export DXVK_LOG_LEVEL=info DXVK_LOG_PATH="$BL_DEBUG_DIR/steam"
+        fi
+        ;;
+    esac
+  fi
+  # DXVK memory and shader-compiler limits for both Valve and adopted Protons (GE-Proton, CachyOS,
+  # DroidDeck-Proton). Notice trackPipelineLifetime=False: PanVK's in-memory vkPipelineCache uses
+  # weak references, so setting trackPipelineLifetime=True destroys compiled VS/FS pipeline
+  # libraries right after background compilation and forces synchronous recompilation on dxvk-cs at
+  # first draw. Combined with heap_memory_percent=0.12 (64 MiB chunks), enableMemoryDefrag=False,
+  # cachedDynamicResources=a, and maxMemoryBudget=384, DXVK keeps memory low while fast-linking GPL.
+  case ${DXVK_CONFIG:+set} in
+    set) ;;
+    *)
+      DXVK_CONFIG="dxvk.numCompilerThreads=${BL_DXVK_COMPILER_THREADS:-4}"
+      DXVK_CONFIG="$DXVK_CONFIG;dxvk.enableGraphicsPipelineLibrary=${BL_DXVK_GPL:-True}"
+      DXVK_CONFIG="$DXVK_CONFIG;dxvk.trackPipelineLifetime=${BL_DXVK_TRACK_PIPELINES:-False}"
+      DXVK_CONFIG="$DXVK_CONFIG;dxvk.enableMemoryDefrag=${BL_DXVK_MEMORY_DEFRAG:-False}"
+      DXVK_CONFIG="$DXVK_CONFIG;d3d11.cachedDynamicResources=${BL_DXVK_CACHED_DYNAMIC:-a}"
+      DXVK_CONFIG="$DXVK_CONFIG;dxvk.maxMemoryBudget=${BL_DXVK_MEMORY_BUDGET:-384}"
+      DXVK_CONFIG="$DXVK_CONFIG;dxgi.maxDeviceMemory=${BL_DXVK_DEVICE_MEMORY:-384}"
+      # Up to three frames in flight: the R8 sessions pinned the truth - the pipeline is CPU-bound
